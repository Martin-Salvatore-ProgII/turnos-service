# Copiar este archivo como .env y cambiar los valores. El .env no se commitea.

# Base de datos de turnos. Los nombres llevan el prefijo TURNOS_ para no pisar las variables
# del catálogo, que se leen de su propio .env cuando este Compose lo incluye.
TURNOS_DB_NAME=turnos
TURNOS_DB_USER=turnos
TURNOS_DB_PASSWORD=cambiar-esta-clave

# Puertos publicados en la máquina
TURNOS_PORT=8080
TURNOS_DB_PORT=5434

# API de la cátedra: URL base y JWT técnico de la cuenta del proyecto (ADR-0005). Son los mismos
# valores que en el .env del catálogo. El resto de la integración se pide a la cátedra al arrancar.
TURNOS_CATEDRA_API_URL=http://servidor-de-la-catedra:puerto
TURNOS_CATEDRA_TECHNICAL_TOKEN=jwt-tecnico

# Administrador inicial. El servicio lo crea al arrancar con estos datos; no se registra desde la
# app. Los tres valores van juntos; los tres vacíos: no hay administrador.
TURNOS_ADMIN_LOGIN=
TURNOS_ADMIN_PASSWORD=
TURNOS_ADMIN_EMAIL=
